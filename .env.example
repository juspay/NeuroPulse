# Environment Variables Template for NeuroPulse
# AI-Powered Jira Integration and Daily Summary System
# Copy this file to .env and fill in your actual values

# ================================
# APPLICATION CONFIGURATION
# ================================

# Node Environment (development, production, test)
NODE_ENV=development

# Application Port
PORT=3000

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# Debug Mode for development
DEBUG=false

# ================================
# JIRA CONFIGURATION
# ================================

# Jira Instance Configuration
# Your Atlassian domain (without https://)
JIRA_DOMAIN=your-company.atlassian.net

# Your Jira account email
JIRA_EMAIL=your-email@company.com

# Jira API Token (generate from: Account Settings > Security > API tokens)
JIRA_API_TOKEN=your_jira_api_token_here

# Default Jira Project Key for daily summaries
JIRA_PROJECT_KEY=PROJ

# Additional Jira project keys (comma-separated for multi-project support)
JIRA_ADDITIONAL_PROJECTS=PROJ2,PROJ3,PROJ4

# Jira API Configuration
JIRA_API_VERSION=3
JIRA_MAX_RESULTS=100
JIRA_REQUEST_TIMEOUT=10000

# ================================
# SLACK CONFIGURATION
# ================================

# Slack Bot Token (starts with xoxb-)
# Get from: Slack App Settings > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Default Slack Channel ID for daily summaries
# Get channel ID by right-clicking channel > View channel details
SLACK_CHANNEL_ID=C1234567890

# Additional Slack channels (comma-separated)
SLACK_ADDITIONAL_CHANNELS=C0987654321,C1122334455

# Slack App Configuration
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Slack API Configuration
SLACK_REQUEST_TIMEOUT=5000
SLACK_RETRY_ATTEMPTS=3

# ================================
# AI SERVICE CONFIGURATION
# ================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# AI Model Selection
AI_MODEL=gpt-4
AI_MODEL_FALLBACK=gpt-3.5-turbo

# AI Request Configuration
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30000

# AI Cost Management
AI_MAX_REQUESTS_PER_HOUR=100
AI_TOKEN_USAGE_ALERT_THRESHOLD=50000

# ================================
# SCHEDULER CONFIGURATION
# ================================

# Daily Summary Schedule (cron format)
# Default: 9 AM on weekdays (Monday-Friday)
DAILY_SUMMARY_CRON=0 9 * * 1-5

# Additional scheduled tasks
WEEKLY_REPORT_CRON=0 10 * * 1
HEALTH_CHECK_CRON=*/15 * * * *

# Timezone for scheduling
TIMEZONE=Asia/Kolkata

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_MAX_CONCURRENT_JOBS=5

# ================================
# PERFORMANCE & CACHING
# ================================

# API Response Caching (in seconds)
JIRA_CACHE_TTL=300
SLACK_CACHE_TTL=3600
AI_CACHE_TTL=0

# Request Rate Limiting
JIRA_RATE_LIMIT=10
SLACK_RATE_LIMIT=50
AI_RATE_LIMIT=20

# Performance Monitoring
ENABLE_PERFORMANCE_METRICS=true
RESPONSE_TIME_THRESHOLD=3000

# ================================
# SECURITY CONFIGURATION
# ================================

# API Security
API_REQUEST_TIMEOUT=30000
MAX_RETRY_ATTEMPTS=3

# Data Protection
SANITIZE_LOGS=true
MASK_SENSITIVE_DATA=true

# Security Headers
ENABLE_SECURITY_HEADERS=true

# ================================
# MONITORING & HEALTH CHECKS
# ================================

# Health Check Configuration
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_INTERVAL=60000

# Monitoring Services
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn-here

# Application Performance Monitoring
ENABLE_APM=false
APM_SERVICE_NAME=neuropulse

# Metrics Collection
ENABLE_METRICS=true
METRICS_PORT=9090

# ================================
# DEVELOPMENT CONFIGURATION
# ================================

# Development Features
ENABLE_DEV_LOGGING=true
ENABLE_DEBUG_ROUTES=false
ENABLE_MOCK_SERVICES=false

# Testing Configuration
TEST_JIRA_PROJECT=TEST
TEST_SLACK_CHANNEL=C9999999999
MOCK_AI_RESPONSES=false

# Development Tools
ENABLE_HOT_RELOAD=true
ENABLE_SOURCE_MAPS=true

# ================================
# FEATURE FLAGS
# ================================

# Feature Toggles
ENABLE_MULTI_PROJECT=true
ENABLE_ADVANCED_AI_ANALYSIS=true
ENABLE_SLACK_THREADS=true
ENABLE_CUSTOM_TEMPLATES=false
ENABLE_PERFORMANCE_DASHBOARD=false

# Experimental Features
ENABLE_VOICE_SUMMARIES=false
ENABLE_PREDICTIVE_ANALYTICS=false

# ================================
# BACKUP & RECOVERY
# ================================

# Data Persistence
ENABLE_CONFIG_BACKUP=true
BACKUP_INTERVAL=24

# Error Recovery
AUTO_RESTART_ON_FAILURE=true
MAX_RESTART_ATTEMPTS=3

# ================================
# MULTI-ENVIRONMENT SUPPORT
# ================================

# Environment-specific overrides
# Production
# PROD_AI_MODEL=gpt-4
# PROD_LOG_LEVEL=error
# PROD_ENABLE_DEBUG=false

# Staging
# STAGING_JIRA_DOMAIN=staging-company.atlassian.net
# STAGING_SLACK_CHANNEL=C_STAGING_CHANNEL

# ================================
# CUSTOM JUSPAY CONFIGURATION
# ================================

# Juspay-specific settings
COMPANY_NAME=Juspay
COMPANY_TIMEZONE=Asia/Kolkata
COMPANY_WORKING_HOURS_START=9
COMPANY_WORKING_HOURS_END=18

# Team-specific configurations
DEFAULT_TEAM_LEAD_MENTION=@team-lead
ESCALATION_CHANNEL=C_ESCALATION_CHANNEL

# Project-specific settings
CRITICAL_PROJECT_THRESHOLD=5
BLOCKER_ALERT_THRESHOLD=3

# ================================
# NOTES & SETUP INSTRUCTIONS
# ================================
#
# SETUP CHECKLIST:
# ☐ 1. Set up Jira API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# ☐ 2. Create Slack bot at: https://api.slack.com/apps
# ☐ 3. Get OpenAI API key at: https://platform.openai.com/api-keys
# ☐ 4. Configure Slack bot permissions: chat:write, channels:read, users:read
# ☐ 5. Add bot to desired Slack channels
# ☐ 6. Test Jira connectivity with your credentials
# ☐ 7. Verify timezone settings for your location
#
# SECURITY NOTES:
# • Never commit .env files to version control
# • Use strong, unique API tokens and secrets
# • Rotate credentials regularly
# • Enable audit logging in production
# • Monitor API usage and costs
#
# PERFORMANCE TIPS:
# • Adjust cache TTL values based on your needs
# • Monitor rate limits for external APIs
# • Use appropriate AI model for cost/quality balance
# • Configure timezone correctly for accurate scheduling
#
# SUPPORT:
# • Documentation: docs/GETTING_STARTED.md
# • API Reference: docs/API.md
# • Issues: https://github.com/juspay/NeuroPulse/issues
# • Contact: opensource@juspay.in
