#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/csv-parser@3.2.0/node_modules/csv-parser/bin/node_modules:/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/csv-parser@3.2.0/node_modules/csv-parser/node_modules:/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/csv-parser@3.2.0/node_modules:/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/csv-parser@3.2.0/node_modules/csv-parser/bin/node_modules:/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/csv-parser@3.2.0/node_modules/csv-parser/node_modules:/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/csv-parser@3.2.0/node_modules:/Users/swetha.s.001/Desktop/ai-agent/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/csv-parser" "$@"
else
  exec node  "$basedir/../../bin/csv-parser" "$@"
fi
