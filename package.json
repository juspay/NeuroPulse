{
  "name": "@juspay/neuropulse",
  "version": "1.0.0",
  "type": "module",
  "description": "NeuroPulse - AI-powered daily summary agent with Slack and Jira integration",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "start:ts": "ts-node --esm index.ts",
    "test": "npm run build && node dist/index.js --now",
    "test:ts": "ts-node --esm index.ts --now",
    "test:jira": "ts-node --esm testJira.ts",
    "help": "ts-node --esm index.ts --help",
    "dev": "ts-node --esm index.ts --now",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "release": "semantic-release"
  },
  "keywords": [
    "javascript",
    "nodejs",
    "typescript",
    "types",
    "express",
    "api",
    "backend",
    "ai",
    "machine-learning"
  ],
  "author": {
    "name": "Juspay Technologies",
    "email": "support@juspay.in",
    "url": "https://juspay.io"
  },
  "license": "ISC",
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@juspay/neurolink": "^7.53.5",
    "@juspay/shelly": "^1.1.0",
    "@slack/socket-mode": "^2.0.5",
    "dot-env": "^0.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.0",
    "@semantic-release/npm": "^11.0.0",
    "@semantic-release/release-notes-generator": "^12.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "repoName": "neuropulse",
  "repoType": "NeuroPulse Express API",
  "hasExistingFiles": {
    "README.md": true,
    "CONTRIBUTING.md": false,
    "CODE_OF_CONDUCT.md": false,
    ".gitignore": true,
    ".eslintrc.js": false,
    ".prettierrc": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swetha-160303/NeuroPulse.git"
  },
  "bugs": {
    "url": "https://github.com/Swetha-160303/NeuroPulse/issues"
  },
  "homepage": "https://github.com/Swetha-160303/NeuroPulse#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "src/",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
